# Copiá este archivo a `.env.local` y completá los valores del proyecto de
# Supabase (Project Settings → API). `.env.local` NO se versiona.

# Las dos que necesita la app en el navegador.
# La anon key es PÚBLICA por diseño: viaja al cliente y se ve en el bundle. Lo que
# protege los datos es RLS, no el secreto de esta clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# Solo para `npm run verificar`: la usuaria creada a mano en el panel de Supabase.
# Sin esto, la verificación de la base se saltea la parte que necesita sesión.
SUPABASE_EMAIL_PRUEBA=
SUPABASE_PASSWORD_PRUEBA=

# La service_role NO va acá ni en ningún archivo del repo. Nunca toca el navegador.
